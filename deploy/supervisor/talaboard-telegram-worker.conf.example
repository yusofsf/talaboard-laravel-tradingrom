; Optional high-throughput mode. Set TELEGRAM_WEBHOOK_QUEUE=database before use.
[program:talaboard-telegram-worker]
process_name=%(program_name)s_%(process_num)02d
command=/usr/bin/php /home/metalspi/talaboard-laravel-tradingrom/artisan queue:work database --queue=telegram --sleep=1 --tries=1 --timeout=45 --max-time=3600
directory=/home/metalspi/talaboard-laravel-tradingrom
autostart=true
autorestart=true
stopasgroup=true
killasgroup=true
user=metalspi
numprocs=2
redirect_stderr=true
stdout_logfile=/home/metalspi/talaboard-laravel-tradingrom/storage/logs/telegram-worker.log
stopwaitsecs=50
