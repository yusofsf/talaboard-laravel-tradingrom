; Keeps the live-price hot cache refreshed without waiting for a user request.
[program:talaboard-scheduler]
command=/usr/bin/php /home/metalspi/talaboard-laravel-tradingrom/artisan schedule:work
directory=/home/metalspi/talaboard-laravel-tradingrom
autostart=true
autorestart=true
stopasgroup=true
killasgroup=true
user=metalspi
redirect_stderr=true
stdout_logfile=/home/metalspi/talaboard-laravel-tradingrom/storage/logs/scheduler.log
stopwaitsecs=10
